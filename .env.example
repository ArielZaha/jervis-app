# Required: the AI that answers questions (free key from https://console.groq.com)
GROQ_API_KEY=

# Optional: Spotify playback control (create an app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Optional: which AI answers. auto = the online AI (Groq) and, if it can't be reached, a local AI (Ollama).
# Use "ollama" to run fully on this PC, or "groq" to never use the local one.
LLM_BACKEND=auto
# Optional: which local model to use (default: the best one installed). Small PC? try llama3.2:1b
OLLAMA_MODEL=

# Optional: which Google account pages open under (in a new tab; the account must be signed in to Chrome).
# Learning things (school documents, Drive, Classroom) use the first, everything else (Gmail, Photos, fun documents) the second.
GOOGLE_ACCOUNT_LEARNING=
GOOGLE_ACCOUNT_PERSONAL=

# Optional: read and create events on Google Calendar (a free OAuth client from https://console.cloud.google.com).
# In the Cloud Console: create a project -> "APIs & Services" -> "OAuth consent screen" (External, Testing is enough,
# add yourself as a test user) -> "Credentials" -> "Create Credentials" -> "OAuth client ID" -> Application type
# "Desktop app". Copy the Client ID and Client secret it gives you below. The first time you use it, a browser tab
# opens once to sign in; after that Jervis remembers it (a local file, .calendar_token.json — never shared, never
# included when this folder is zipped up for anyone else).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional (macOS): let Jervis read your WhatsApp chats (unread messages, what someone wrote). Reading only, on this Mac only.
# Set to off to disable.
WHATSAPP_READING=on

# Images: understanding pictures (describing them, answering questions, reading text, comparing) uses the same
# GROQ_API_KEY above, through a vision-capable model — nothing extra to set up. Optional override:
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Generating a picture also works with no setup (a free, keyless service, Pollinations.ai).

# Optional: better-quality image generation, and editing an existing picture (Pollinations can only create new
# ones). Get a key at https://platform.openai.com ("API keys" in your account) and add a little billing credit —
# image generation isn't covered by any free OpenAI tier. If this is set but ever fails (no credits, bad key), image
# generation falls back to the free service automatically; editing always needs this key.
OPENAI_API_KEY=
# Optional: which OpenAI image model to use.
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: genuinely unlimited, free, private image generation on this computer's own GPU (or CPU) instead of a
# cloud service. Not installed by default (a multi-GB download) — run:  python3 run.py --local-images
# When installed, it's tried first (before OpenAI/Pollinations); if it's not installed, or it fails or times out
# (needs real free memory — see README.md > Images), generation falls back to the other providers automatically.
# Optional: which local model to use (default is the fastest one that still looks reasonable, stabilityai/sd-turbo).
# LOCAL_IMAGE_MODEL=stabilityai/sd-turbo
