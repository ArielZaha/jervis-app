{
  "name": "jervis",
  "productName": "Jervis",
  "version": "1.0.0",
  "description": "Jervis, a voice assistant that runs on your own computer",
  "author": "Ariel & Shalev",
  "homepage": "https://arielzaha.github.io/jervis/",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "backend": "pyinstaller --noconfirm --distpath backend-dist --workpath build/pyinstaller jervis-backend.spec",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.arielzaha.jervis",
    "productName": "Jervis",
    "copyright": "© 2026 Ariel & Shalev",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "package.json",
      "main.js",
      "backend.js",
      "renderer.js",
      "panels.js",
      "orb.js",
      "bg.js",
      "graph.js",
      "earth.js",
      "planet.js",
      "index.html",
      "style.css",
      "control.html",
      "control.js",
      "control-preload.js",
      "assets/**",
      "vendor/**"
    ],
    "extraResources": [
      {
        "from": "backend-dist/jervis-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "afterPack": "build-resources/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "executableName": "Jervis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Jervis",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Jervis Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Jervis-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jervis listens for “Hey Jervis” and for what you ask him.",
        "NSAppleEventsUsageDescription": "Jervis controls apps you ask him to use, like Spotify or your browser.",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Jervis ${version}"
    }
  }
}
